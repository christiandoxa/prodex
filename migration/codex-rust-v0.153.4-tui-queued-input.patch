+
+#[derive(Debug, Clone, PartialEq, Eq)]
+pub(super) struct ExternalQueuedMessage {
+    pub(super) id: String,
+    pub(super) text: String,
+}
+
+impl ExternalQueuedMessage {
+    fn from_submission(submission: QueuedSubmission) -> Self {
+        let mut text = submission
+            .input
+            .into_iter()
+            .filter_map(|input| match input {
+                UserInput::Text { text, .. } => Some(text),
+                _ => None,
+            })
+            .collect::<Vec<_>>()
+            .join("\n");
+        if text.chars().count() > MAX_EXTERNAL_QUEUE_PREVIEW_CHARS {
+            text = text
+                .chars()
+                .take(MAX_EXTERNAL_QUEUE_PREVIEW_CHARS)
+                .collect();
+            text.push('…');
+        }
+        if text.is_empty() {
+            text = "[queued input]".to_string();
+        }
+        Self {
+            id: submission.id,
+            text,
+        }
+    }
 }
 
