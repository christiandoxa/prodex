{
  "name": "prodex-workspace",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "prodex-workspace",
      "workspaces": [
        "npm/prodex",
        "npm/prodex-gateway-sdk"
      ],
      "optionalDependencies": {
        "@christiandoxa/prodex-darwin-arm64": "file:npm/platforms/darwin-arm64",
        "@christiandoxa/prodex-darwin-x64": "file:npm/platforms/darwin-x64",
        "@christiandoxa/prodex-linux-arm64": "file:npm/platforms/linux-arm64",
        "@christiandoxa/prodex-linux-x64": "file:npm/platforms/linux-x64",
        "@christiandoxa/prodex-win32-arm64": "file:npm/platforms/win32-arm64",
        "@christiandoxa/prodex-win32-x64": "file:npm/platforms/win32-x64"
      }
    },
    "node_modules/@christiandoxa/prodex": {
      "resolved": "npm/prodex",
      "link": true
    },
    "node_modules/@christiandoxa/prodex-darwin-arm64": {
      "resolved": "npm/platforms/darwin-arm64",
      "link": true
    },
    "node_modules/@christiandoxa/prodex-darwin-x64": {
      "resolved": "npm/platforms/darwin-x64",
      "link": true
    },
    "node_modules/@christiandoxa/prodex-gateway-sdk": {
      "resolved": "npm/prodex-gateway-sdk",
      "link": true
    },
    "node_modules/@christiandoxa/prodex-linux-arm64": {
      "resolved": "npm/platforms/linux-arm64",
      "link": true
    },
    "node_modules/@christiandoxa/prodex-linux-x64": {
      "resolved": "npm/platforms/linux-x64",
      "link": true
    },
    "node_modules/@christiandoxa/prodex-win32-arm64": {
      "resolved": "npm/platforms/win32-arm64",
      "link": true
    },
    "node_modules/@christiandoxa/prodex-win32-x64": {
      "resolved": "npm/platforms/win32-x64",
      "link": true
    },
    "npm/platforms/darwin-arm64": {
      "name": "@christiandoxa/prodex-darwin-arm64",
      "version": "0.428.0",
      "cpu": [
        "arm64"
      ],
      "license": "Apache-2.0",
      "optional": true,
      "os": [
        "darwin"
      ]
    },
    "npm/platforms/darwin-x64": {
      "name": "@christiandoxa/prodex-darwin-x64",
      "version": "0.428.0",
      "cpu": [
        "x64"
      ],
      "license": "Apache-2.0",
      "optional": true,
      "os": [
        "darwin"
      ]
    },
    "npm/platforms/linux-arm64": {
      "name": "@christiandoxa/prodex-linux-arm64",
      "version": "0.428.0",
      "cpu": [
        "arm64"
      ],
      "license": "Apache-2.0",
      "optional": true,
      "os": [
        "linux"
      ]
    },
    "npm/platforms/linux-x64": {
      "name": "@christiandoxa/prodex-linux-x64",
      "version": "0.428.0",
      "cpu": [
        "x64"
      ],
      "license": "Apache-2.0",
      "optional": true,
      "os": [
        "linux"
      ]
    },
    "npm/platforms/win32-arm64": {
      "name": "@christiandoxa/prodex-win32-arm64",
      "version": "0.428.0",
      "cpu": [
        "arm64"
      ],
      "license": "Apache-2.0",
      "optional": true,
      "os": [
        "win32"
      ]
    },
    "npm/platforms/win32-x64": {
      "name": "@christiandoxa/prodex-win32-x64",
      "version": "0.428.0",
      "cpu": [
        "x64"
      ],
      "license": "Apache-2.0",
      "optional": true,
      "os": [
        "win32"
      ]
    },
    "npm/prodex": {
      "name": "@christiandoxa/prodex",
      "version": "0.428.0",
      "license": "Apache-2.0",
      "bin": {
        "prodex": "prodex"
      },
      "engines": {
        "node": ">=18"
      },
      "optionalDependencies": {
        "@christiandoxa/prodex-darwin-arm64": "0.428.0",
        "@christiandoxa/prodex-darwin-x64": "0.428.0",
        "@christiandoxa/prodex-linux-arm64": "0.428.0",
        "@christiandoxa/prodex-linux-x64": "0.428.0",
        "@christiandoxa/prodex-win32-arm64": "0.428.0",
        "@christiandoxa/prodex-win32-x64": "0.428.0"
      }
    },
    "npm/prodex-gateway-sdk": {
      "name": "@christiandoxa/prodex-gateway-sdk",
      "version": "0.428.0",
      "license": "Apache-2.0",
      "engines": {
        "node": ">=18"
      }
    }
  }
}
